LMS_USERNAME=your_student_id
LMS_PASSWORD=your_password
LMS_BASE_URL=https://lms4.ui.ac.ir
DB_PATH=./data/lms.db
LOG_LEVEL=INFO
LMS_ENV=production
LMS_SECRET_KEY=...   # تصادفی بلند
LMS_COOKIE_SECURE=1
LMS_BACKUP_INTERVAL_HOURS=24
LMS_BACKUP_KEEP=14
LMS_REVOKE_OTHER_SESSIONS=1 # پیش‌فرض
LMS_CORS_ORIGINS=https://your-domain.com