{
  "manifest_version": 3,
  "name": "LMS Assistant Login Bridge",
  "version": "1.0",
  "description": "ورود خودکار به کلاس‌های آنلاین LMS",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.ui.ac.ir/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "اتصال به LMS"
  }
}